{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "allowJs": true,
    "checkJs": false,
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "frontend/src/**/*",
    "backend/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "frontend/dist"
  ]
}
